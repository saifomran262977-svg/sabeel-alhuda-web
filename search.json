---
layout: null
sitemap: false
---
[
{% assign all_items = site.books | concat: site.fatwas %}
{% for item in all_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "description": {{ item.description | default: item.excerpt | strip_html | truncate: 180 | jsonify }},
    "author": {{ item.author | default: site.author.name | jsonify }},
    "category": {{ item.category | default: "" | jsonify }},
    "tags": {{ item.tags | default: empty | jsonify }},
    "type": "{% if item.collection == 'fatwas' %}fatwa{% else %}book{% endif %}"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
